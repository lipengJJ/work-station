# docker-compose 的真实密钥（.env.example 是模板，可以提交）
.env

# 根目录运行日志与本地工具数据（锚定根目录，避免误伤 src/views/settings/logs 页面目录）
/logs/
.workbuddy-ai/

# backend
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.db
backend/workbench.db
backend/node_modules/
# xhs 采集任务的产出（素材/Excel），不进版本库
backend/storage/
backend/app/storage/
# 应用运行日志，不进版本库
backend/logs/

# frontend (Vben Admin monorepo)
frontend/**/node_modules/
frontend/**/dist/
frontend/**/dist.zip
frontend/**/.turbo/
frontend/**/.cache/
frontend/**/.env.local
# 临时验证脚本
frontend/_tmp_*
frontend/**/verify-logic.tmp.mjs

# ---- 推 GitHub 前的补充规整 ----
# 前端 .env（含 store 加密密钥占位符），每开发者本地不同，不提交（.env.development/.env.production 等配置保留）
frontend/**/.env


# 通用杂项
.DS_Store
*.db-journal
*.db-wal
*.db-shm
*.sqlite3

# ---- 推 GitHub 前的补充规整 ----
# 前端 .env（含 store 加密密钥占位符），每开发者本地不同，不提交（.env.development/.env.production 等配置保留）
frontend/**/.env


# 通用杂项
.DS_Store
*.db-journal
*.db-wal
*.db-shm
*.sqlite3

# docker bind mount 挂载目录（宿主机持久化数据，不进版本库）
/data/
/storage/
backend/config.json

# 临时归档与本地工具中间产物（understand 等）
_to_delete/
backend/.ua/
