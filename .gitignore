# docker-compose 的真实密钥（.env.example 是模板，可以提交）
.env

# backend
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.db
backend/workbench.db
backend/node_modules/
# xhs 采集任务的产出（素材/Excel），不进版本库
backend/storage/

# frontend (Vben Admin monorepo)
frontend/**/node_modules/
frontend/**/dist/
frontend/**/dist.zip
frontend/**/.turbo/
frontend/**/.cache/
frontend/**/.env.local
