VITE_BASE=/

# 接口地址：相对路径，由 nginx 反向代理到 backend 容器，跟前端同源，
# 不用在构建时写死具体的域名/IP，换环境不用重新构建镜像
VITE_GLOB_API_URL=/api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
