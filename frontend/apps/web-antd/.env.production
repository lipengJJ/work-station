# 应用标题（Vite 原生 %VITE_APP_TITLE% 占位符替换用，index.html / 加载动画都引用它；
# 缺失时 Vite 会把占位符原样留在页面上，不会报错也不会用兜底默认值）
VITE_APP_TITLE=统一工作台

VITE_BASE=/

# 接口地址：相对路径，由 nginx 反向代理到 backend 容器，跟前端同源，
# 不用在构建时写死具体的域名/IP，换环境不用重新构建镜像
VITE_GLOB_API_URL=/api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
