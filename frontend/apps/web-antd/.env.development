# 端口号（workbench-notify 分支使用独立端口 5668，避免与主工作区 5666 / mobile 5676 冲突）
VITE_PORT=5668

VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭（我们接的是自己的 FastAPI 后端，不需要 mock）
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
